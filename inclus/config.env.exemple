# =============================================================================
#  EndlessClient / Poly+ — fichier de configuration central
# =============================================================================
#
#  Copiez ce fichier en `inclus/config.env`, remplissez-le, puis lancez les
#  scripts de `inclus/scripts/`. Tous les scripts et tous les modèles
#  (systemd, nginx, .env) sont générés à partir de ces valeurs.
#
#      cp inclus/config.env.exemple inclus/config.env
#      chmod 600 inclus/config.env
#      nano inclus/config.env
#
#  Chaque valeur marquée CHANGEME DOIT être remplacée : les scripts refusent
#  de démarrer tant qu'il en reste une.
#
#  Générer un secret solide :   openssl rand -base64 36
#
#  GUILLEMETS : ce fichier est lu par le shell. Les secrets sont entre
#  guillemets simples — GARDEZ-LES. Sans eux, un mot de passe contenant &, $,
#  #, une espace ou un point-virgule casse le chargement de la configuration.
#  Si votre secret contient lui-même une apostrophe, écrivez-la '\'' :
#      ADMIN_PASSWORD='mot'\''de'\''passe'
#  Le plus simple reste de générer les secrets avec openssl, qui ne produit
#  que des caractères sans danger.
#
#  /!\ Ce fichier contient tous les secrets de la production.
#      Il est ignoré par git (voir inclus/.gitignore). Ne le commitez jamais.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Domaines
# -----------------------------------------------------------------------------
# Le domaine racine sert la boutique. Les trois sous-domaines sont dérivés
# automatiquement, mais vous pouvez les surcharger juste en dessous.
DOMAIN=endlessclient.dev

# Décommentez uniquement si vous voulez des noms différents de api./admin./cdn.
#DOMAIN_API=api.endlessclient.dev
#DOMAIN_ADMIN=admin.endlessclient.dev
#DOMAIN_CDN=cdn.endlessclient.dev
#DOMAIN_WWW=www.endlessclient.dev

# Adresse utilisée pour l'enregistrement Let's Encrypt (avis d'expiration).
CERTBOT_EMAIL=CHANGEME@example.com


# -----------------------------------------------------------------------------
# 2. Emplacement sur le serveur
# -----------------------------------------------------------------------------
SERVICE_USER=endless
INSTALL_ROOT=/opt/endless

# Dépôt à cloner dans $INSTALL_ROOT/src
GIT_REPO=https://github.com/Th3DarkSand8tch/AstralClient.git
GIT_BRANCH=v2


# -----------------------------------------------------------------------------
# 3. PostgreSQL
# -----------------------------------------------------------------------------
DB_NAME=endless_plus
DB_USER=endless
DB_PASSWORD='CHANGEME_MOT_DE_PASSE_POSTGRES'


# -----------------------------------------------------------------------------
# 4. Stockage objet (MinIO)
# -----------------------------------------------------------------------------
# Compte racine MinIO — utilisé uniquement pour l'administration.
MINIO_ROOT_USER=endless-root
MINIO_ROOT_PASSWORD='CHANGEME_MOT_DE_PASSE_MINIO_ROOT'

# Bucket et clé applicative dédiée (l'API n'utilise jamais le compte racine).
S3_BUCKET=endless-cosmetics
S3_REGION=us-east-1
S3_ACCESS_KEY=endless-api
S3_SECRET_KEY='CHANGEME_SECRET_S3'


# -----------------------------------------------------------------------------
# 5. API
# -----------------------------------------------------------------------------
# Comparé en clair sur chaque requête /cosmetics/manage/* : pas de hachage,
# pas de limitation de débit, pas de verrouillage. Faites-le long et aléatoire.
ADMIN_PASSWORD='CHANGEME_MOT_DE_PASSE_ADMIN_TRES_LONG'

RUST_LOG=info,sea_orm=warn,sqlx=warn


# -----------------------------------------------------------------------------
# 6. Stripe
# -----------------------------------------------------------------------------
# Les quatre variables STRIPE_* sont OBLIGATOIRES pour le démarrage du backend.
# Une valeur vide est acceptée, une variable absente fait planter le processus.
# Créer un cosmétique provisionne un produit + un prix Stripe : sans clé
# valide, l'API sert le catalogue existant mais ne peut rien y ajouter.
#
# Gardez des clés de TEST (sk_test_...) tant que vous n'encaissez pas réellement.
STRIPE_SECRET='sk_test_CHANGEME'
STRIPE_WEBHOOK_SECRET='whsec_CHANGEME'
# Laissez commenté pour dériver automatiquement de $DOMAIN :
#STRIPE_SUCCESS_URL=https://endlessclient.dev/checkout/success
#STRIPE_CANCEL_URL=https://endlessclient.dev/checkout/cancel


# -----------------------------------------------------------------------------
# 7. Accès au tableau de bord admin
#    (auth HTTP nginx, en plus du mot de passe API ci-dessus)
# -----------------------------------------------------------------------------
ADMIN_HTTP_USER=admin
ADMIN_HTTP_PASSWORD='CHANGEME_MOT_DE_PASSE_HTTP_ADMIN'


# -----------------------------------------------------------------------------
# 8. Premier administrateur
# -----------------------------------------------------------------------------
# Votre UUID Minecraft, tirets inclus. Pour le récupérer :
#   curl -s https://api.mojang.com/users/profiles/minecraft/VOTREPSEUDO | jq -r .id
# (l'API Mojang le renvoie sans tirets ; le script 90 les rajoute tout seul)
MINECRAFT_UUID=CHANGEME-VOTRE-UUID-MINECRAFT


# -----------------------------------------------------------------------------
# 9. Ports internes (à ne changer que si un conflit existe)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
RENDER_PORT=8090
SHOP_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001


# -----------------------------------------------------------------------------
# 10. Sauvegardes
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/endless
# Nombre de jours de rétention des dumps PostgreSQL locaux.
BACKUP_RETENTION_DAYS=14
