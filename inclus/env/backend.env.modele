# =============================================================================
#  Environnement du service endless-backend
#  Généré par inclus/scripts/50-backend.sh — destination :
#      @@SECRETS_DIR@@/backend.env      (root:@@SERVICE_USER@@, 0640)
#
#  Ne modifiez pas ce fichier à la main : éditez inclus/config.env puis
#  relancez le script, sinon la prochaine exécution écrasera vos changements.
# =============================================================================

RUST_LOG=@@RUST_LOG@@

# L'API n'écoute que sur la boucle locale ; nginx est le seul point d'entrée.
# Sans cette variable, le binaire écouterait sur [::]:8080 ET 0.0.0.0:8080.
BIND_ADDR=127.0.0.1:@@BACKEND_PORT@@

# Le mot de passe est encodé pour-cent : c'est une URL, un « @ » ou un « / »
# brut la couperait au mauvais endroit.
DATABASE_URL=postgresql://@@DB_USER@@:@@DB_PASSWORD_URL@@@127.0.0.1:5432/@@DB_NAME@@

# ---------------------------------------------------------------------------
# Stockage objet
# ---------------------------------------------------------------------------
# S3_BUCKET_ENDPOINT sert à construire les URL présignées renvoyées aux
# navigateurs et au jeu : ce DOIT être le nom d'hôte public. Avec « localhost »
# ici, toutes les images de cosmétiques renvoient 404 côté client.
S3_BUCKET_NAME=@@S3_BUCKET@@
S3_BUCKET_REGION=@@S3_REGION@@
S3_BUCKET_ENDPOINT=https://@@DOMAIN_CDN@@
AWS_ACCESS_KEY_ID=@@S3_ACCESS_KEY@@
AWS_SECRET_ACCESS_KEY=@@S3_SECRET_KEY@@

# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
# Comparaison de chaîne en clair sur chaque /cosmetics/manage/*, sans
# limitation de débit ni verrouillage de compte.
ADMIN_PASSWORD=@@ADMIN_PASSWORD@@

# ---------------------------------------------------------------------------
# Stripe — les quatre variables sont obligatoires.
# Vide = accepté. Absente = le processus refuse de démarrer.
# ---------------------------------------------------------------------------
STRIPE_SECRET=@@STRIPE_SECRET@@
STRIPE_WEBHOOK_SECRET=@@STRIPE_WEBHOOK_SECRET@@
STRIPE_SUCCESS_URL=@@STRIPE_SUCCESS_URL@@
STRIPE_CANCEL_URL=@@STRIPE_CANCEL_URL@@

# ---------------------------------------------------------------------------
# Service de rendu des vignettes (facultatif)
# ---------------------------------------------------------------------------
RENDER_SERVICE_URL=http://127.0.0.1:@@RENDER_PORT@@

# ---------------------------------------------------------------------------
# CORS — exactement vos origines, rien d'autre.
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://@@DOMAIN@@,https://@@DOMAIN_WWW@@,https://@@DOMAIN_ADMIN@@

# ---------------------------------------------------------------------------
# Adresse IP du client
# ---------------------------------------------------------------------------
# L'API ne voit jamais que nginx. RightmostXForwardedFor lit la dernière valeur
# de X-Forwarded-For — et nginx ÉCRASE cet en-tête (proxy_set_header
# X-Forwarded-For $remote_addr), donc un en-tête forgé par le client ne
# survit pas. Les deux réglages vont ensemble : changer l'un casse l'autre.
CLIENT_IP_SOURCE=RightmostXForwardedFor
