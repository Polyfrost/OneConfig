{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "OneConfig",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "Polyfrost"
  ],
  "contact": {
    "homepage": "https://polyfrost.org",
    "sources": "https://github.com/Polyfrost/OneConfig",
    "issues": "https://inv.wtf/polyfrost"
  },
  "icon": "oneconfig-icon.png",
  "provides": [
    "oneconfigbootstrap"
  ],
  "license": "LGPL-3.0",
  "environment": "client",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${mc_version}",
    "oneconfigv1": "${mod_version}",
    "compose-multiplatform": ">=${compose_version}",
    "fabric-language-kotlin": ">=${flk_version}"
  },
  "breaks": {
    "chattweaks": "<1.2.3",
    "crashpatch": "<2.2.3",
    "evergreenhud": "<3.9.13",
    "polydium": "<1.2.0",
    "polyplus": "<1.4.0"
  }
}
