<?xml version="1.0" ?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoModifyConstant"/>
            <property name="format" value="@ModifyConstant\(" />
            <property name="ignoreComments" value="true" />
            <property name="message"
                value="@ModifyConstant creates incompatibilities with other mods. Use @ModifyExpressionValue with @At(value = &quot;CONSTANT&quot;) instead."/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="id" value="NoOverwrite" />
            <property name="format" value="@Overwrite\b" />
            <property name="ignoreComments" value="true" />
            <property name="message"
                value="@Overwrite creates incompatibilities with other mods. Use more compatible injectors such as @WrapMethod instead." />
        </module>

        <module name="RegexpSinglelineJava">
            <property name="id" value="NoRedirect" />
            <property name="format" value="@Redirect\(" />
            <property name="ignoreComments" value="true" />
            <property name="message"
                value="@Redirect creates incompatibilities with other mods. Use more compatible injectors such as @WrapOperation instead." />
        </module>

        <module name="SuppressWarningsHolder" />
    </module>

    <module name="SuppressWarningsFilter" />
</module>
