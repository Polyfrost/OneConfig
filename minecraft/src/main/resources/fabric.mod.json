{
  "schemaVersion": 1,
  "id": "oneconfig",
  "provides": [
    "oneconfigv1",
    "oneconfigbootstrap"
  ],
  "name": "OneConfig",
  "version": "${mod_version}",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "Polyfrost"
  ],
  "contact": {
    "homepage": "https://polyfrost.org",
    "sources": "https://github.com/Polyfrost/OneConfig",
    "issues": "https://inv.wtf/polyfrost"
  },
  "icon": "oneconfig-icon.png",
  "license": "LGPL-3.0",
  "environment": "client",
  "accessWidener": "oneconfigv1.classtweaker",
  "mixins": [
    "mixins.oneconfigv1.init.json",
    "mixins.oneconfigv1.json"
  ],
  "entrypoints": {
    "client": [
      "org.polyfrost.oneconfig.internal.OneConfig"
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.oneconfig.internal.compat.ModMenuEntrypoint"
      }
    ],
    "preLaunch": [
      "org.polyfrost.oneconfig.internal.OneConfigPreLaunch"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_mc_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk_version}",
    "compose-multiplatform": ">=${compose_version}"
  },
  "breaks": {
    "chattweaks": "<1.2.3",
    "crashpatch": "<2.2.3",
    "evergreenhud": "<3.9.13",
    "polydium": "<1.2.0",
    "polyplus": "<1.4.0"
  }
}